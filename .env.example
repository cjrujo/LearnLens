# Local development requires no variables. The default is http://127.0.0.1:3210.
# For hosted deployment behind an HTTPS reverse proxy:
HOST=0.0.0.0
PORT=3210
PUBLIC_ORIGIN=https://learnlens.example.com
# Replace this with a unique random secret, at least 16 characters.
LEARNLENS_ACCESS_PASSWORD=

# Optional local/self-hosted Kokoro OpenAI-compatible speech service.
# This endpoint is trusted operator configuration, never browser input.
# Use http://127.0.0.1:8880/v1 for a service on the same host;
# with containers, use the service hostname on your private Docker network.
# KOKORO_BASE_URL=http://kokoro:8880/v1
# KOKORO_MODEL=kokoro
# KOKORO_VOICE=af_heart
# KOKORO_API_KEY=
