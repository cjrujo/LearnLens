{
  "name": "learnlens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Screenshot-first, provider-independent AI tutoring.",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "start": "node deploy/native-start.mjs",
    "start:lite": "node --env-file-if-exists=.env server.mjs",
    "setup:speech": "node deploy/setup-native.mjs",
    "test:native": "node tests/native-smoke.mjs",
    "dev": "node --watch deploy/native-start.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node deploy/check-syntax.mjs",
    "test:browser": "node tests/browser-smoke.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "kokoro-js": "1.2.1"
  },
  "overrides": {
    "phonemizer": "1.2.1",
    "sharp": "0.35.5"
  }
}
