# npm start loads the repository-root .env automatically. Shell variables win.
# Local PC or VPS behind a reverse proxy: bind only to loopback.
HOST=127.0.0.1
PORT=3210

# Public VPS private beta: uncomment and replace BOTH values in a local editor.
# PUBLIC_ORIGIN=https://learnlens.your-domain.example
# LEARNLENS_ACCESS_PASSWORD=replace-with-unique-random-password-at-least-16-characters

# Native Kokoro starts automatically with npm start. No service URL/key needed.
# First start prepares pinned model assets; later starts reuse .cache/speech/.
# LEARNLENS_SPEECH_OFFLINE=1
# LEARNLENS_SPEECH_THREADS=2
# LEARNLENS_SPEECH_CACHE=.cache/speech
# LEARNLENS_SPEECH_MODE=disabled

# Advanced operator override: use an EXISTING service instead of the native worker.
# KOKORO_BASE_URL=https://your-existing-speech-service.example/v1
# KOKORO_MODEL=kokoro
# KOKORO_VOICE=af_heart
# KOKORO_API_KEY=

# Optional Docker deployment only: HOST must be 0.0.0.0 inside the container;
# PUBLIC_ORIGIN and LEARNLENS_ACCESS_PASSWORD are then mandatory.
