# Local development requires no variables. The default is http://127.0.0.1:3210.
# For hosted deployment behind an HTTPS reverse proxy:
HOST=0.0.0.0
PORT=3210
PUBLIC_ORIGIN=https://learnlens.example.com
# Replace this with a unique random secret, at least 16 characters.
LEARNLENS_ACCESS_PASSWORD=

# Kokoro is included and started automatically by the standard container.
# No speech URL/key or learner installation is needed. Advanced operator overrides:
# LEARNLENS_SPEECH_MODE=disabled
# KOKORO_BASE_URL=https://your-existing-speech-service.example/v1
# KOKORO_MODEL=kokoro
# KOKORO_VOICE=af_heart
# KOKORO_API_KEY=
